# Copy to `.env` and fill in when you wire up Supabase (Phase: "go online").
# The offline build ignores these entirely — the app runs on localStorage
# until a Supabase backend is configured.
#
# SAFE TO SHIP: both of these are public by design. The anon key is readable
# by anyone who loads the site; security comes from Row Level Security, not
# from hiding this key. See docs/setup-supabase.md.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# NEVER put the service_role key here, in any committed file, or in CI.
# It bypasses RLS and would expose all data.

# Optional: override the GitHub Pages base path (e.g. "/" for a custom domain).
# VITE_BASE=/job-tracker/
